# ==============================================================================
# Janus Gateway Environment Variables Template
# ==============================================================================

# Server Listening Port (Default: 18763)
PORT=18763

# Server Binding Host (Default: 127.0.0.1 for local security, 0.0.0.0 for LAN/Docker)
HOST=127.0.0.1

# Master API Key for downstream Agent clients (Claude Code CLI, Cursor, Aider, etc.)
GATEWAY_API_KEY=sk-gateway-local-token

# Path to the primary configuration file (Default: ./config.json)
CONFIG_PATH=./config.json

# Path to the Google Account Pool storage (Default: ./data/google-accounts.json)
GOOGLE_ACCOUNTS_PATH=./data/google-accounts.json

# Path to local OpenAI Codex authentication credentials (Default: ~/.codex/auth.json)
CODEX_AUTH_PATH=~/.codex/auth.json

# Log level: debug | info | warn | error (Default: info)
LOG_LEVEL=info
